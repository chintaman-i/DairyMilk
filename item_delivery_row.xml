<?xml version="1.0" encoding="utf-8"?>
<!-- item_delivery_row.xml — used in Customer App Recent Deliveries list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Date + Status Row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView android:id="@+id/tvDeliveryDate" android:text="2024-09-09"
            android:textSize="14sp" android:textStyle="bold" android:textColor="#212121"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>

        <TextView android:id="@+id/tvDeliveryStatus" android:text="Recorded"
            android:textSize="11sp" android:textColor="#757575"
            android:background="@drawable/status_badge_bg"
            android:paddingStart="8dp" android:paddingEnd="8dp"
            android:paddingTop="2dp" android:paddingBottom="2dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Morning/Evening amounts -->
    <TextView android:id="@+id/tvMorningEvening" android:text="Morning: 15L, Evening: 12L"
        android:textSize="12sp" android:textColor="#616161" android:layout_marginBottom="4dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <!-- Fat / SNF / Rate + Amount Row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <TextView android:id="@+id/tvFat" android:text="Fat: 4.2%"
            android:textSize="12sp" android:textColor="#757575"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"/>

        <TextView android:id="@+id/tvSnf" android:text="SNF: 8.5%"
            android:textSize="12sp" android:textColor="#757575"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"/>

        <TextView android:id="@+id/tvRate" android:text="Rate: ₹45"
            android:textSize="12sp" android:textColor="#757575"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>

        <TextView android:id="@+id/tvAmount" android:text="₹1215"
            android:textSize="14sp" android:textStyle="bold" android:textColor="#388E3C"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#F0F0F0" android:layout_marginTop="10dp"/>
</LinearLayout>
