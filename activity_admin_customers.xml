<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:text="Dairy Management System" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="#1565C0"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Admin Dashboard" android:textSize="12sp"
                    android:textColor="#757575" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:paddingBottom="8dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:text="Overview" android:layout_width="wrap_content"
                    android:layout_height="36dp" android:gravity="center" android:paddingStart="16dp"
                    android:paddingEnd="16dp" android:textSize="13sp" android:textColor="#424242"
                    android:background="@drawable/tab_unselected_bg" android:layout_marginEnd="6dp"/>
                <TextView android:text="Collection" android:layout_width="wrap_content"
                    android:layout_height="36dp" android:gravity="center" android:paddingStart="16dp"
                    android:paddingEnd="16dp" android:textSize="13sp" android:textColor="#424242"
                    android:background="@drawable/tab_unselected_bg" android:layout_marginEnd="6dp"/>
                <TextView android:text="Feed" android:layout_width="wrap_content"
                    android:layout_height="36dp" android:gravity="center" android:paddingStart="16dp"
                    android:paddingEnd="16dp" android:textSize="13sp" android:textColor="#424242"
                    android:background="@drawable/tab_unselected_bg" android:layout_marginEnd="6dp"/>
                <TextView android:text="Customers" android:layout_width="wrap_content"
                    android:layout_height="36dp" android:gravity="center" android:paddingStart="16dp"
                    android:paddingEnd="16dp" android:textSize="13sp" android:textColor="#FFFFFF"
                    android:background="@drawable/tab_selected_bg" android:layout_marginEnd="6dp"/>
                <TextView android:text="Reports" android:layout_width="wrap_content"
                    android:layout_height="36dp" android:gravity="center" android:paddingStart="16dp"
                    android:paddingEnd="16dp" android:textSize="13sp" android:textColor="#424242"
                    android:background="@drawable/tab_unselected_bg" android:layout_marginEnd="6dp"/>
                <TextView android:text="Settings" android:layout_width="wrap_content"
                    android:layout_height="36dp" android:gravity="center" android:paddingStart="16dp"
                    android:paddingEnd="16dp" android:textSize="13sp" android:textColor="#424242"
                    android:background="@drawable/tab_unselected_bg"/>
            </LinearLayout>
        </HorizontalScrollView>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="12dp"
        android:clipToPadding="false">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 4 Stat Cards: Total, Active, Pending Payments, Monthly Collection -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp">

                <androidx.cardview.widget.CardView android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    app:cardCornerRadius="12dp" app:cardElevation="2dp" android:layout_marginEnd="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp"
                            android:src="@drawable/ic_group" app:tint="#1565C0" android:layout_marginBottom="4dp"/>
                        <TextView android:text="Total Customers" android:textSize="10sp"
                            android:textColor="#757575" android:gravity="center"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tvTotalCustomers" android:text="4"
                            android:textSize="20sp" android:textStyle="bold" android:textColor="#1565C0"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    app:cardCornerRadius="12dp" app:cardElevation="2dp" android:layout_marginStart="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp"
                            android:src="@drawable/ic_group" app:tint="#388E3C" android:layout_marginBottom="4dp"/>
                        <TextView android:text="Active Customers" android:textSize="10sp"
                            android:textColor="#757575" android:gravity="center"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tvActiveCustomers" android:text="3"
                            android:textSize="20sp" android:textStyle="bold" android:textColor="#388E3C"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="14dp">

                <androidx.cardview.widget.CardView android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    app:cardCornerRadius="12dp" app:cardElevation="2dp" android:layout_marginEnd="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp"
                            android:src="@drawable/ic_currency_rupee" app:tint="#E65100"
                            android:layout_marginBottom="4dp"/>
                        <TextView android:text="Pending Payments" android:textSize="10sp"
                            android:textColor="#757575" android:gravity="center"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tvPendingPayments" android:text="₹129k"
                            android:textSize="18sp" android:textStyle="bold" android:textColor="#E65100"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    app:cardCornerRadius="12dp" app:cardElevation="2dp" android:layout_marginStart="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp"
                            android:src="@drawable/ic_calendar_month" app:tint="#7B1FA2"
                            android:layout_marginBottom="4dp"/>
                        <TextView android:text="Monthly Collection" android:textSize="10sp"
                            android:textColor="#757575" android:gravity="center"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tvMonthlyCollection" android:text="2530L"
                            android:textSize="18sp" android:textStyle="bold" android:textColor="#7B1FA2"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Customer List / Payment History Tabs -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp">
                <Button android:id="@+id/btnCustomerList" android:layout_width="wrap_content"
                    android:layout_height="36dp" android:text="Customer List" android:textSize="13sp"
                    android:textColor="#FFFFFF" android:backgroundTint="#212121"
                    android:layout_marginEnd="8dp" style="@style/Widget.MaterialComponents.Button"/>
                <Button android:id="@+id/btnPaymentHistory" android:layout_width="wrap_content"
                    android:layout_height="36dp" android:text="Payment History" android:textSize="13sp"
                    android:textColor="#424242" android:backgroundTint="#FFFFFF"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>

            <!-- Search and Add Customer Row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="8dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearchCustomers" android:layout_width="match_parent"
                        android:layout_height="48dp" android:hint="Search customers..."
                        android:drawableStart="@drawable/ic_search" android:drawablePadding="8dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <Button android:id="@+id/btnAddCustomer" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:text="+ Add Customer" android:textSize="13sp"
                    android:textColor="#FFFFFF" android:backgroundTint="#1565C0"
                    style="@style/Widget.MaterialComponents.Button"/>
            </LinearLayout>

            <!-- Customer Directory Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="10dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:text="Customer Directory" android:textSize="15sp"
                        android:textStyle="bold" android:textColor="#212121"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                    <TextView android:text="Manage customer information and track performance"
                        android:textSize="12sp" android:textColor="#9E9E9E"
                        android:layout_marginBottom="12dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                    <!-- Table Header -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:paddingBottom="8dp">
                        <TextView android:text="Customer" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="2.5"
                            android:textSize="12sp" android:textStyle="bold" android:textColor="#424242"/>
                        <TextView android:text="Contact" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="2.5"
                            android:textSize="12sp" android:textStyle="bold" android:textColor="#424242"/>
                        <TextView android:text="This Month" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1.5"
                            android:textSize="12sp" android:textStyle="bold" android:textColor="#424242"
                            android:gravity="end"/>
                        <TextView android:text="Avg" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:textSize="12sp" android:textStyle="bold" android:textColor="#424242"
                            android:gravity="end"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#E0E0E0" android:layout_marginBottom="6dp"/>

                    <!-- Customer Rows RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCustomers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
