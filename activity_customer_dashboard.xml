<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:text="Dairy Customer App" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="#388E3C"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvWelcomeUser" android:text="Welcome, Rajesh Kumar"
                    android:textSize="12sp" android:textColor="#757575"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="12dp"
        android:clipToPadding="false">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Account Summary Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="14dp"
                app:cardElevation="3dp" android:layout_marginBottom="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp"
                    android:background="@drawable/gradient_green_card">

                    <TextView android:text="Account Summary" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="#1565C0" android:gravity="center"
                        android:layout_width="match_parent" android:layout_height="wrap_content"/>

                    <TextView android:id="@+id/tvCustomerId" android:text="DRY001"
                        android:textSize="13sp" android:textColor="#757575" android:gravity="center"
                        android:layout_marginBottom="14dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content"/>

                    <!-- This Month + Earnings Row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:gravity="center">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                android:src="@drawable/ic_milk_bottle" app:tint="#1565C0"
                                android:layout_marginBottom="4dp"/>
                            <TextView android:text="This Month" android:textSize="12sp"
                                android:textColor="#757575" android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/tvThisMonth" android:text="850L"
                                android:textSize="20sp" android:textStyle="bold" android:textColor="#1565C0"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="60dp"
                            android:background="#E0E0E0"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:gravity="center">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                android:src="@drawable/ic_currency_rupee" app:tint="#388E3C"
                                android:layout_marginBottom="4dp"/>
                            <TextView android:text="Earnings" android:textSize="12sp"
                                android:textColor="#757575" android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/tvEarnings" android:text="₹38,250"
                                android:textSize="20sp" android:textStyle="bold" android:textColor="#388E3C"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Payment Status Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="12dp"
                app:cardElevation="2dp" android:layout_marginBottom="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_schedule" app:tint="#E65100"
                            android:layout_marginEnd="6dp"/>
                        <TextView android:text="Payment Status" android:textSize="15sp"
                            android:textStyle="bold" android:textColor="#E65100"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Milk Payment Row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:text="Milk Payment Pending:" android:textSize="13sp"
                            android:textColor="#424242" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"/>
                        <TextView android:id="@+id/tvMilkPaymentPending" android:text="₹38,250"
                            android:textSize="13sp" android:textStyle="bold" android:textColor="#E53935"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Feed Payment Row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:text="Feed Payment Pending:" android:textSize="13sp"
                            android:textColor="#424242" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"/>
                        <TextView android:id="@+id/tvFeedPaymentPending" android:text="₹8,500"
                            android:textSize="13sp" android:textStyle="bold" android:textColor="#E53935"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#E0E0E0" android:layout_marginBottom="8dp"/>

                    <!-- Total Due -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <TextView android:text="Total Due:" android:textSize="14sp"
                            android:textStyle="bold" android:textColor="#212121"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <TextView android:id="@+id/tvTotalDue" android:text="₹46,750"
                            android:textSize="14sp" android:textStyle="bold" android:textColor="#E53935"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Next Payment Info -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                        android:orientation="vertical" android:gravity="center"
                        android:background="#E3F2FD" android:padding="8dp">
                        <TextView android:id="@+id/tvNextPaymentDate" android:text="Next Payment: 2024-09-15"
                            android:textSize="13sp" android:textColor="#424242" android:gravity="center"
                            android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tvDaysRemaining" android:text="6 days remaining"
                            android:textSize="12sp" android:textStyle="bold" android:textColor="#1565C0"
                            android:gravity="center" android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Feed Account Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="12dp"
                app:cardElevation="2dp" android:layout_marginBottom="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_inventory_2" app:tint="#388E3C"
                            android:layout_marginEnd="6dp"/>
                        <TextView android:text="Feed Account" android:textSize="15sp"
                            android:textStyle="bold" android:textColor="#212121"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:text="Advance Balance:" android:textSize="13sp"
                            android:textColor="#424242" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"/>
                        <TextView android:id="@+id/tvAdvanceBalance" android:text="₹2,500 (Owe)"
                            android:textSize="13sp" android:textStyle="bold" android:textColor="#E53935"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@drawable/ic_schedule" app:tint="#E65100"
                            android:layout_marginEnd="4dp"/>
                        <TextView android:text="Outstanding feed payment" android:textSize="13sp"
                            android:textColor="#E65100" android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Deliveries / Payments / Feed Tabs -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/filter_tab_bg"
                android:layout_marginBottom="12dp">

                <TextView android:id="@+id/tabDeliveries" android:text="Deliveries"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:gravity="center" android:textSize="13sp"
                    android:textStyle="bold" android:textColor="#212121"
                    android:background="@drawable/tab_bottom_indicator"/>

                <TextView android:id="@+id/tabPayments" android:text="Payments"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:gravity="center" android:textSize="13sp"
                    android:textColor="#757575"/>

                <TextView android:id="@+id/tabFeed" android:text="Feed"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:gravity="center" android:textSize="13sp"
                    android:textColor="#757575"/>
            </LinearLayout>

            <!-- Recent Deliveries Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="12dp"
                app:cardElevation="2dp" android:layout_marginBottom="10dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:text="Recent Deliveries" android:textSize="15sp"
                        android:textStyle="bold" android:textColor="#212121"
                        android:layout_marginBottom="4dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                    <TextView android:text="Your milk delivery history" android:textSize="12sp"
                        android:textColor="#9E9E9E" android:layout_marginBottom="12dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                    <!-- RecyclerView for delivery entries -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvRecentDeliveries"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
