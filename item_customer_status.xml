<?xml version="1.0" encoding="utf-8"?>
<!-- item_customer_status.xml — used in Collection screen Customer Status list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">

        <TextView android:id="@+id/tvCustomerNameStatus"
            android:text="001 - Rajesh Kumar"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView android:id="@+id/tvCustomerRate"
            android:text="₹45/L"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Status Icon: check_circle (green) or cancel (red) -->
    <ImageView
        android:id="@+id/ivStatus"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_cancel"
        app:tint="#E53935"/>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#F0F0F0"/>
</LinearLayout>
