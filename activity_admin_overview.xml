<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:text="Dairy Management System"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Admin Dashboard"
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <!-- Tab Navigation -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Overview Tab (selected) -->
                <TextView
                    android:id="@+id/tabOverview"
                    android:text="Overview"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/tab_selected_bg"
                    android:layout_marginEnd="6dp"/>

                <TextView android:id="@+id/tabCollection" android:text="Collection"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:textSize="13sp" android:textColor="#424242"
                    android:background="@drawable/tab_unselected_bg" android:layout_marginEnd="6dp"/>

                <TextView android:id="@+id/tabFeed" android:text="Feed"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:textSize="13sp" android:textColor="#424242"
                    android:background="@drawable/tab_unselected_bg" android:layout_marginEnd="6dp"/>

                <TextView android:id="@+id/tabCustomers" android:text="Customers"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:textSize="13sp" android:textColor="#424242"
                    android:background="@drawable/tab_unselected_bg" android:layout_marginEnd="6dp"/>

                <TextView android:id="@+id/tabReports" android:text="Reports"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:textSize="13sp" android:textColor="#424242"
                    android:background="@drawable/tab_unselected_bg" android:layout_marginEnd="6dp"/>

                <TextView android:id="@+id/tabSettings" android:text="Settings"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:textSize="13sp" android:textColor="#424242"
                    android:background="@drawable/tab_unselected_bg"/>

            </LinearLayout>
        </HorizontalScrollView>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="12dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Month/Year Filter Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <Spinner
                    android:id="@+id/spinnerMonth"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/spinner_bg"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="10dp"/>

                <Spinner
                    android:id="@+id/spinnerYear"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="10dp"/>

            </LinearLayout>

            <!-- Export Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Button
                    android:id="@+id/btnExportPdf"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="⬇ Export PDF"
                    android:textSize="13sp"
                    android:textColor="#424242"
                    android:backgroundTint="#FFFFFF"
                    android:strokeColor="#BDBDBD"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginEnd="10dp"/>

                <Button
                    android:id="@+id/btnExportExcel"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="⬇ Export Excel"
                    android:textSize="13sp"
                    android:textColor="#424242"
                    android:backgroundTint="#FFFFFF"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

            </LinearLayout>

            <!-- Stat Card: Total Collection -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_milk_bottle"
                        app:tint="#1565C0"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:text="Total Collection (Sep)"
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvTotalCollection"
                        android:text="87,000L"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvCollectionChange"
                        android:text="-17% from Aug"
                        android:textSize="12sp"
                        android:textColor="#E53935"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Stat Card: Revenue -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_currency_rupee"
                        app:tint="#388E3C"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:text="Revenue (Sep)"
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvRevenue"
                        android:text="₹39.15L"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#388E3C"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvRevenueChange"
                        android:text="-17% from Aug"
                        android:textSize="12sp"
                        android:textColor="#E53935"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Stat Card: Active Customers -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_group"
                        app:tint="#7B1FA2"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:text="Active Customers"
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvActiveCustomers"
                        android:text="42"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#7B1FA2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvCustomerChange"
                        android:text="+3 this month"
                        android:textSize="12sp"
                        android:textColor="#388E3C"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Stat Card: Avg Rate -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_trending_up"
                        app:tint="#E65100"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:text="Avg Rate"
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvAvgRate"
                        android:text="₹45/L"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#E65100"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvRateChange"
                        android:text="+₹2 from last month"
                        android:textSize="12sp"
                        android:textColor="#388E3C"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Milk Collection Trend Chart Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:text="Milk Collection Trend"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Monthly milk collection over time"
                        android:textSize="12sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginBottom="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Chart placeholder - use MPAndroidChart LineChart here -->
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartCollectionTrend"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Revenue Trend Chart Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:text="Revenue Trend"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Monthly revenue from milk sales"
                        android:textSize="12sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginBottom="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chartRevenueTrend"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
